# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=
# НЕОБЯЗАТЕЛЬНО. Без ключа бот сопоставляет товары по правилам. С ключом — через Claude + скриншоты (платно)
ANTHROPIC_API_KEY=
# Модель Claude (можно не менять)
ANTHROPIC_MODEL=claude-opus-5
# Ваш город/адрес — цены и доставка зависят от него
REGION=Москва
# Цены ВкусВилла: mcp (реальные, через MCP-сервер ВкусВилла) или mock (вымышленные)
VKUSVILL_SOURCE=mcp
