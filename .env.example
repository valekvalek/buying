# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=
# Ключ Anthropic API с https://console.anthropic.com (нужен для сопоставления через LLM и скриншотов)
ANTHROPIC_API_KEY=
# Модель Claude (можно не менять)
ANTHROPIC_MODEL=claude-opus-5
# Ваш город/адрес — цены и доставка зависят от него
REGION=Москва
# Цены ВкусВилла: mcp (реальные, через MCP-сервер ВкусВилла) или mock (вымышленные)
VKUSVILL_SOURCE=mcp
